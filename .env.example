# Ballpark server environment — copy to .env and fill in. (.env is gitignored.)

# ── Database (Supabase Postgres) ─────────────────────────────────────────
APP_SCHEMA=public
DATABASE_URL=
DIRECT_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Storage buckets ──────────────────────────────────────────────────────
STORAGE_BUCKET_PROJECTS=dev-project-assets
STORAGE_BUCKET_SUPPLIERS=dev-supplier-assets

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201

# ── Google OAuth (pV2-02 auth) ───────────────────────────────────────────
# console.cloud.google.com → Credentials → OAuth 2.0 Client ID (Web app).
# Authorised JS origins: http://localhost:4201
# Authorised redirect URI: http://localhost:3001/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:3001/auth/google/callback

# ── Session JWT (pV2-02 auth) ────────────────────────────────────────────
JWT_SECRET=                # long random string, e.g. `openssl rand -hex 48`
JWT_COOKIE_DOMAIN=         # leave empty for localhost
JWT_COOKIE_SECURE=false    # true in prod (HTTPS only)
WEB_BASE_URL=http://localhost:4201   # SPA base, for post-login redirect

# ── Integrations ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
UNSPLASH_ACCESS_KEY=
RESEND_API_KEY=
EMAIL_FROM=noreply@theballpark.ai
